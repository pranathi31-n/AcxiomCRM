<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/site.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
<div class="container-fluid">
<a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">AcxiomCRM</a>
<button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div id="nav" class="collapse navbar-collapse">
@if(User.Identity?.IsAuthenticated == true) {
<ul class="navbar-nav me-auto">
<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-Ups</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
@if(User.IsInRole("Admin")||User.IsInRole("Manager")) { <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit</a></li> }
@if(User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li> }
</ul>
<span class="navbar-text me-3">@User.Identity.Name</span>
<form asp-area="Identity" asp-page="/Account/Logout" method="post"><button class="btn btn-outline-light btn-sm">Logout</button></form>
}
</div></div></nav>
<main class="container py-4">@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>} @RenderBody()</main>
<footer class="border-top text-center py-3 text-muted">AcxiomCRM &copy; @DateTime.Now.Year</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>