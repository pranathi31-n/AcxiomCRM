@model Activity
<h2>Add Activity</h2><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="ActivityType"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div>
<div class="col-md-6"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control"/></div><div class="col-12"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="col-md-6"><label asp-for="ActivityDate"></label><input asp-for="ActivityDate" class="form-control" type="datetime-local"/></div><div class="col-md-6"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Completed</option><option>Cancelled</option></select></div><div class="col-12"><button class="btn btn-primary">Save</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
