@model Customer
@if(Model==null){<div class="alert alert-danger">Customer not found.</div>}else{<h2>@Model.CustomerName</h2><div class="card"><div class="card-body"><dl class="row"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.City, @Model.State</dd></dl></div></div><a asp-action="Index" class="btn btn-secondary mt-3">Back</a>}