@model Opportunity
<h2>Edit Opportunity</h2><form asp-action="Edit" method="post" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" asp-for="OpportunityId"/><input type="hidden" asp-for="CreatedDate"/><input type="hidden" asp-for="AssignedTo"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="OpportunityName"></label><input asp-for="OpportunityName" class="form-control"/></div><div class="col-md-6"><label asp-for="CustomerId"></label><input asp-for="CustomerId" class="form-control"/></div>
<div class="col-md-4"><label asp-for="Amount"></label><input asp-for="Amount" class="form-control"/></div><div class="col-md-4"><label asp-for="Probability"></label><input asp-for="Probability" class="form-control"/></div><div class="col-md-4"><label asp-for="ExpectedCloseDate"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date"/></div>
<div class="col-md-6"><label asp-for="Stage"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-md-6"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Won</option><option>Lost</option></select></div><div class="col-12"><button class="btn btn-primary">Update</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
