@model IEnumerable<Opportunity>
<div class="d-flex justify-content-between mb-3"><h2>Opportunities</h2><a class="btn btn-primary" asp-action="Create">+ Add Opportunity</a></div>
<form class="row g-2 mb-3"><div class="col-md-5"><input name="search" class="form-control" placeholder="Search opportunity"/></div><div class="col-md-3"><select name="stage" class="form-select"><option value="">All stages</option><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form>
<table class="table table-hover"><thead><tr><th>Name</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close Date</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.OpportunityName</td><td>@x.Customer?.CustomerName</td><td>@x.Stage</td><td>@x.Amount.ToString("C")</td><td>@x.Probability%</td><td>@x.WeightedPipeline.ToString("C")</td><td>@x.ExpectedCloseDate.ToString("dd-MMM-yyyy")</td><td>@x.Status</td><td><a asp-action="Edit" asp-route-id="@x.OpportunityId">Edit</a></td></tr>}</tbody></table>