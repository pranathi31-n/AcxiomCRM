@model Opportunity
@inject AcxiomCRM.Data.ApplicationDbContext Db
<h2>Create Opportunity</h2><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="OpportunityName"></label><input asp-for="OpportunityName" class="form-control"/></div>
<div class="col-md-6"><label asp-for="CustomerId"></label><select asp-for="CustomerId" class="form-select"><option value="">-- select --</option>@foreach(var c in Db.Customers){<option value="@c.CustomerId">@c.CustomerName</option>}</select></div>
<div class="col-md-4"><label asp-for="Amount"></label><input asp-for="Amount" class="form-control"/></div><div class="col-md-4"><label asp-for="Probability"></label><input asp-for="Probability" class="form-control"/></div><div class="col-md-4"><label asp-for="ExpectedCloseDate"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date"/></div>
<div class="col-md-6"><label asp-for="Stage"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div>
<div class="col-md-6"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Won</option><option>Lost</option></select></div><div class="col-12"><button class="btn btn-primary">Save</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
