@model FollowUp
@inject AcxiomCRM.Data.ApplicationDbContext Db
<h2>Schedule Follow-Up</h2><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="FollowUpDate"></label><input asp-for="FollowUpDate" class="form-control" type="date"/></div><div class="col-md-6"><label asp-for="FollowUpType"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div>
<div class="col-md-6"><label asp-for="CustomerId"></label><select asp-for="CustomerId" class="form-select"><option value="">-- none --</option>@foreach(var c in Db.Customers){<option value="@c.CustomerId">@c.CustomerName</option>}</select></div>
<div class="col-md-6"><label asp-for="LeadId"></label><select asp-for="LeadId" class="form-select"><option value="">-- none --</option>@foreach(var l in Db.Leads){<option value="@l.LeadId">@l.LeadName</option>}</select></div>
<div class="col-12"><label asp-for="Remarks"></label><textarea asp-for="Remarks" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">Save</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
