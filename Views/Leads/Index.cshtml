@model IEnumerable<Lead>
<div class="d-flex justify-content-between mb-3"><h2>Leads</h2><a class="btn btn-primary" asp-action="Create">+ Add Lead</a></div>
<form class="row g-2 mb-3"><div class="col-md-5"><input name="search" class="form-control" placeholder="Search lead/company"/></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form>
<table class="table table-hover"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Source</th><th>Status</th><th>Value</th><th>Actions</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.LeadCode</td><td>@x.LeadName</td><td>@x.CompanyName</td><td>@x.Source</td><td>@x.Status</td><td>@x.ExpectedValue.ToString("C")</td><td><a asp-action="Edit" asp-route-id="@x.LeadId">Edit</a> @if(x.Status=="Qualified"){<form asp-action="Convert" asp-route-id="@x.LeadId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Convert</button></form>}</td></tr>}</tbody></table>